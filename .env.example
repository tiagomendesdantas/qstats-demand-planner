# Optional overrides. Copy to .env (git-ignored) and export before running.
# The schema uses portable types only, but only SQLite has been run. For PostgreSQL or Azure SQL,
# install the driver first (it is not a dependency): `uv add psycopg[binary]`, or `uv add pyodbc`
# plus Microsoft's ODBC Driver 18. Then:
#   postgresql+psycopg://user:pass@host:5432/planner
#   mssql+pyodbc://user:pass@server.database.windows.net/planner?driver=ODBC+Driver+18+for+SQL+Server
QSTATS_DATABASE_URL=sqlite:///data/planner.sqlite
QSTATS_CONFIG=config/demo.yaml
# Parallel simulated worlds in the policy comparison (default: min(8, CPUs, memory / 1.2 GB)).
# QSTATS_WORKERS=4
# Repository root, needed only for a non-editable install.
# QSTATS_ROOT=/path/to/qstats-demand-planner
