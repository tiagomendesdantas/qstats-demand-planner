# Optional overrides. Copy to .env (git-ignored) and export before running.
# A PostgreSQL or Azure SQL URL works the same way as the default SQLite file:
#   postgresql+psycopg://user:pass@host:5432/planner
#   mssql+pyodbc://user:pass@server.database.windows.net/planner?driver=ODBC+Driver+18+for+SQL+Server
QSTATS_DATABASE_URL=sqlite:///data/planner.sqlite
QSTATS_CONFIG=config/demo.yaml
